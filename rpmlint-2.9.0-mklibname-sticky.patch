diff -ruN a/test/test_speccheck.py b/test/test_speccheck.py
--- a/test/test_speccheck.py	2026-02-11 09:08:15.000000000 +0100
+++ b/test/test_speccheck.py	2026-08-15 19:36:24.602884520 +0200
@@ -976,6 +976,16 @@
     assert 'E: lib-package-without-%mklibname' not in out
 
 
+@pytest.mark.parametrize('package', ['spec/lib-package-with-%mklibname-not-last'])
+def test_check_mklibname_not_only_last_line(package, speccheck):
+    """%mklibname on an early line must count even if later lines omit it."""
+    output, test = speccheck
+    pkg = get_tested_spec_package(package)
+    test.check_spec(pkg)
+    out = output.print_results(output.results)
+    assert 'E: lib-package-without-%mklibname' not in out
+
+
